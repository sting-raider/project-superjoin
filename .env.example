APP_ENV=demo
HOST=0.0.0.0
PORT=8080
DATABASE_PATH=/app/data/project_superjoin.sqlite3
UPLOAD_DIR=/app/data/uploads
DEMO_MODE=true

# Optional OpenAI-compatible provider defaults. Leave all provider values empty
# for the recorded no-key demo. Model names are deployment-specific and are
# never allowlisted by Project SuperJoin.
#
# OpenAI, OpenRouter, Together, Groq, vLLM, and compatible gateways normally
# use Authorization/Bearer and the /chat/completions + /embeddings paths.
# Azure OpenAI can set *_AUTH_HEADER=api-key, *_AUTH_SCHEME=, and its
# deployment/query path through *_CHAT_PATH or EMBEDDING_PATH. Ollama can use
# a local /v1 endpoint with an empty API key.
AI_BASE_URL=
AI_API_KEY=
EXTRACTION_BASE_URL=
EXTRACTION_API_KEY=
REASONING_BASE_URL=
REASONING_API_KEY=
VISION_BASE_URL=
VISION_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EXTRACTION_MODEL=
REASONING_MODEL=
VISION_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
EMBEDDING_INCLUDE_DIMENSIONS=true
AI_TIMEOUT_SECONDS=90
AI_INPUT_PRICE_PER_MILLION=0.35
AI_OUTPUT_PRICE_PER_MILLION=0.53
EXTRACTION_TIMEOUT_SECONDS=90
REASONING_TIMEOUT_SECONDS=90
VISION_TIMEOUT_SECONDS=90
EMBEDDING_TIMEOUT_SECONDS=90
EXTRACTION_MAX_OUTPUT_TOKENS=2400
REASONING_MAX_OUTPUT_TOKENS=1200
VISION_MAX_OUTPUT_TOKENS=1200
EXTRACTION_CONCURRENCY=2
EXTRACTION_BATCH_PAGES=3
EXTRACTION_BATCH_CHARS=12000
EXTRACTION_HINT_LIMIT=16
EXTRACTION_CLAIMS_PER_BATCH=4
EXTRACTION_BATCH_RETRY_ROUNDS=1
EXTRACTION_BATCH_RETRY_DELAY_SECONDS=5
REASONING_CONCURRENCY=2
RELATIONSHIP_CANDIDATE_LIMIT=12
RELATIONSHIP_SEMANTIC_LIMIT=24
VISION_CONCURRENCY=2
EMBEDDING_CONCURRENCY=2
EMBEDDING_BATCH_SIZE=128
REGISTRY_SEMANTIC_LIMIT=4
EXTRACTION_STRUCTURED_OUTPUT_MODE=json_object
REASONING_STRUCTURED_OUTPUT_MODE=json_object
VISION_STRUCTURED_OUTPUT_MODE=json_object
EMBEDDING_TASK_TYPE=retrieval_document
EXTRACTION_CHAT_PATH=/chat/completions
REASONING_CHAT_PATH=/chat/completions
VISION_CHAT_PATH=/chat/completions
EMBEDDING_PATH=/embeddings
EXTRACTION_AUTH_HEADER=Authorization
REASONING_AUTH_HEADER=Authorization
VISION_AUTH_HEADER=Authorization
EMBEDDING_AUTH_HEADER=Authorization
EXTRACTION_AUTH_SCHEME=Bearer
REASONING_AUTH_SCHEME=Bearer
VISION_AUTH_SCHEME=Bearer
EMBEDDING_AUTH_SCHEME=Bearer
EXTRACTION_SEND_MODEL=true
REASONING_SEND_MODEL=true
VISION_SEND_MODEL=true
EMBEDDING_SEND_MODEL=true
# Optional provider-specific OpenAI-compatible request fields. Each value is a
# JSON object; the application contains no provider or model allowlist.
EXTRACTION_EXTRA_BODY_JSON=
REASONING_EXTRA_BODY_JSON=
VISION_EXTRA_BODY_JSON=
EMBEDDING_EXTRA_BODY_JSON=
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=0.5
AI_BUDGET_USD=20
MAX_PDF_MB=100
MAX_PDF_PAGES=2000

# Example only (do not paste credentials into this tracked file):
# EXTRACTION_BASE_URL=https://integrate.api.nvidia.com/v1
# EXTRACTION_API_KEY=${NVIDIA_API_KEY}
# EXTRACTION_MODEL=nvidia/nemotron-3-super-120b-a12b
#
# DeepSeek V4 Flash example (API key stays in a local .env):
# EXTRACTION_BASE_URL=https://api.deepseek.com
# EXTRACTION_API_KEY=${DEEPSEEK_API_KEY}
# EXTRACTION_MODEL=deepseek-v4-flash
# EXTRACTION_EXTRA_BODY_JSON={"thinking":{"type":"disabled"}}
# REASONING_BASE_URL=https://api.deepseek.com
# REASONING_API_KEY=${DEEPSEEK_API_KEY}
# REASONING_MODEL=deepseek-v4-flash
# REASONING_EXTRA_BODY_JSON={"thinking":{"type":"disabled"}}
